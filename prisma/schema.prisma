generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model alarm {
  alarmId    Int    @id @default(autoincrement())  @map("alarm_id")
  type       String    @db.VarChar(50)
  detail     String?   @db.Text
  createdAt  DateTime? @default(now()) @db.DateTime(0) @map("created_at")
  updatedAt  DateTime? @default(now()) @db.DateTime(0) @map("updated_at")
  userId     Int     @map("user_id")
  user       user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_alarm_user")

  @@index([userId], map: "idx_alarm_user")
}

model food_category {
  id                  Int                   @id @default(autoincrement()) @db.UnsignedInt
  name                String                @unique(map: "uk_food_category_name") @db.VarChar(100)
  user_favor_category user_favor_category[]
}

model inquiry {
  inquiryId  Int    @id @default(autoincrement())  @map("inquiry_id")
  sub        String?   @db.VarChar(200)
  detail     String?   @db.Text
  pic        Json?
  answer     Boolean?  @default(false)
  userId     Int     @map("user_id")
  createdAt  DateTime? @default(now()) @db.DateTime(0) @map("created_at")
  user       user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inquiry_user")

  @@index([userId], map: "idx_inquiry_user")
}

model mission {
  missionId     Int       @id @default(autoincrement())  @map("mission_id")
  detail        String?      @db.VarChar(255)
  compensation  Int?         @default(0)
  restaurantId  Int        @map("restaurant_id")
  createdAt     DateTime?    @default(now()) @db.DateTime(0) @map("created_at")
  restaurant    restaurant   @relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade, onUpdate: NoAction, map: "fk_mission_rest")
  myMission     my_mission[] 

  @@index([restaurantId], map: "idx_mission_restaurant")
}

model my_mission {
  myMissionId        Int    @id @default(autoincrement())  @map("my_mission_id")
  state              String    @db.VarChar(30)
  classificationNum  Int?      @map("classification_num")
  createdAt          DateTime? @default(now()) @db.DateTime(0) @map("created_at")
  userId             Int     @map("user_id")
  missionId          Int     @map("mission_id")
  mission            mission   @relation(fields: [missionId], references: [missionId], onDelete: Cascade, onUpdate: NoAction, map: "fk_mm_mission")
  user               user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mm_user")
  point              point[]

  @@index([missionId], map: "idx_mm_mission")
  @@index([userId], map: "idx_mm_user")
}

model point {
  pointId      Int      @id @default(autoincrement())  @map("point_id")
  history      String?     @db.VarChar(255)
  date         DateTime?   @default(now()) @db.DateTime(0)
  userId       Int       @map("user_id")
  myMissionId  Int?      @map("my_mission_id")
  myMission    my_mission? @relation(fields: [myMissionId], references: [myMissionId], onUpdate: NoAction, map: "fk_point_my_mission")
  user         user        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_point_user")

  @@index([myMissionId], map: "idx_point_my_mission")
  @@index([userId], map: "idx_point_user")
}

model restaurant {
  restaurantId   Int    @id @default(autoincrement())  @map("restaurant_id")
  address        String    @db.VarChar(255)
  name           String    @db.VarChar(150)
  operatingHours String?   @db.VarChar(150) @map("operatingHours")
  pic            Json?
  foodType       Json?
  createdAt      DateTime? @default(now()) @db.DateTime(0) @map("created_at")
  updatedAt      DateTime? @default(now()) @db.DateTime(0) @map("updated_at")
  mission        mission[]
  review         review[]
}

model review {
  reviewId     Int     @id @default(autoincrement())  @map("review_id")
  score        Float      @db.Float
  detail       String?    @db.Text
  pic          Json?
  restaurantId Int      @map("restaurant_id")
  userId       Int      @map("user_id")
  createdAt    DateTime?  @default(now()) @db.DateTime(0) @map("created_at")
  restaurant   restaurant @relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_rest")
  user         user       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_user")

  @@index([restaurantId], map: "idx_review_rest")
  @@index([userId], map: "idx_review_user")
}

model terms_of_service {
  termId               Int                  @id @default(autoincrement())  @map("term_id")
  first                 String?                 @db.VarChar(255)
  second                String?                 @db.VarChar(255)
  third                 String?                 @db.VarChar(255)
  fourth                String?                 @db.VarChar(255)
  fifth                 String?                 @db.VarChar(255)
  user_terms_of_service user_terms_of_service[]
}

model user {
  id                    Int                  @id @default(autoincrement()) 
  email                 String                  @unique(map: "uk_user_email") @db.VarChar(255)
  password              String                  @db.VarChar(255)
  name                  String                  @db.VarChar(100)
  gender                String                  @db.VarChar(20)
  birth                 DateTime                @db.Date
  address               String?                 @default("") @db.VarChar(255)
  detailAddress         String?                 @default("") @db.VarChar(255) @map("detail_address")
  phoneNumber           String                  @db.VarChar(50) @map("phone_number")
  numberAuth            Boolean?                @default(false) @map("number_auth")
  createdAt             DateTime?               @default(now()) @db.DateTime(0) @map("created_at")
  nickname              String?                 @db.VarChar(100)
  updatedAt             DateTime?               @default(now()) @db.DateTime(0) @map("updated_at")
  expiredAt             DateTime?               @db.DateTime(0) @map("expired_at")
  isDeleted             Boolean?                @default(false) @map("is_deleted")
  points                Int?                    @default(0) @map("point")
  alarm                 alarm[]
  inquiry               inquiry[]
  myMission             my_mission[]            
  point                 point[]
  review                review[]
  user_favor_category   user_favor_category[]
  user_terms_of_service user_terms_of_service[]
}

model user_favor_category {
  id               Int           @id @default(autoincrement()) @db.UnsignedInt
  userId           Int           @map("user_id")
  foodCategoryId   Int           @db.UnsignedInt @map("food_category_id")
  food_category    food_category @relation(fields: [foodCategoryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ufc_food")
  user             user          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ufc_user")

  @@unique([userId, foodCategoryId], map: "uk_ufc_user_food")
  @@index([foodCategoryId], map: "idx_ufc_food")
  @@index([userId], map: "idx_ufc_user")
}

model user_terms_of_service {
  userTermId     Int              @id @default(autoincrement())   @map("user_term_id")
  userId         Int              @map("user_id")
  termId         Int            @map("term_id")
  first          Boolean?         @default(false)
  second         Boolean?         @default(false)
  third          Boolean?         @default(false)
  fourth         Boolean?         @default(false)
  fifth          Boolean?         @default(false)
  createdAt      DateTime?        @default(now()) @db.DateTime(0) @map("created_at")
  termsOfService terms_of_service @relation(fields: [termId], references: [termId], onDelete: Cascade, onUpdate: NoAction, map: "fk_utos_term")
  user           user             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_utos_user")

  @@index([termId], map: "idx_utos_term")
  @@index([userId], map: "idx_utos_user")
}